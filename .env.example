# ============================================================
#  .env.example  –  Copy this to .env and fill in your keys
# ============================================================

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# --- Twilio (WhatsApp Sandbox) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Default Twilio sandbox number

# --- Gmail ---
# Download credentials.json from Google Cloud Console and place it
# in the project root folder. The app will generate token.json automatically.
